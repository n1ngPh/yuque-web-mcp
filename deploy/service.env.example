YUQUE_HOST=https://www.yuque.com
YUQUE_PERSONAL_HOST=https://www.yuque.com
YUQUE_ORGANIZATION=
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://yuque-mcp.example.com
MCP_ALLOWED_HOSTS=yuque-mcp.example.com
MCP_ALLOWED_ORIGINS=
MCP_OWNER_ID=<replace-with-a-stable-owner-id>
MCP_BEARER_TOKEN=<replace-with-at-least-32-random-bytes>
SESSION_ENCRYPTION_KEY=<replace-with-base64-of-exactly-32-random-bytes>
LOGIN_TTL_SECONDS=300
CHANGE_TTL_SECONDS=600
YUQUE_REQUEST_TIMEOUT_MS=15000
WRITE_CONSISTENCY_MODE=strict
WRITE_KILL_SWITCH=false
ALLOW_UNVERIFIED_CONTRACTS=false
ALLOW_OBJECT_DELETION=false
ALLOW_PERMISSION_CHANGES=false
YUQUE_WRITE_BOOK_ALLOWLIST=
ALLOW_INSECURE_HTTP=false
MAX_MCP_SESSIONS=32
MAX_CONCURRENT_REQUESTS=16
MAX_REQUESTS_PER_SESSION=4
MCP_SESSION_IDLE_SECONDS=1800
MAX_REQUEST_BODY_BYTES=1572864
MAX_CONCURRENT_LOGINS=2
GRACEFUL_SHUTDOWN_SECONDS=30
METRICS_ENABLED=true
# Optional outbound proxy and private CA. Never disable TLS verification.
YUQUE_HTTPS_PROXY=
YUQUE_CA_FILE=
