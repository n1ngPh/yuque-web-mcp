YUQUE_HOST=https://www.yuque.com
YUQUE_PERSONAL_HOST=https://www.yuque.com
YUQUE_ORGANIZATION=
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://yuque-mcp.example.com
MCP_ALLOWED_HOSTS=yuque-mcp.example.com
MCP_ALLOWED_ORIGINS=
MCP_OWNER_ID=<replace-with-a-stable-owner-id>
MCP_BEARER_TOKEN=<replace-with-a-random-token-of-at-least-32-bytes>
# Optional: bind the single-owner deployment to a Xiatang agent_id so the REST
# endpoint POST /api/call accepts "X-Agent-Id" authentication in addition to
# "Authorization: Bearer". For multi-user mode, put agent_id inside users.json
# (MCP_USERS_FILE) instead.
# MCP_AGENT_ID=<replace-with-xiatang-agent-id>
# Optional: multi-user file, an object {"users":[{owner_id, bearer_token, agent_id?}]}.
# MCP_USERS_FILE=/absolute/path/to/users.json
SESSION_ENCRYPTION_KEY=<replace-with-base64-of-exactly-32-random-bytes>
LOGIN_TTL_SECONDS=300
CHANGE_TTL_SECONDS=600
YUQUE_REQUEST_TIMEOUT_MS=15000
WRITE_CONSISTENCY_MODE=strict
WRITE_KILL_SWITCH=false
ALLOW_UNVERIFIED_CONTRACTS=false
ALLOW_OBJECT_DELETION=false
ALLOW_PERMISSION_CHANGES=false
# Existing-book writes require the matching Host switch. Both default off.
YUQUE_WRITE_ORGANIZATION_OPEN=false
YUQUE_WRITE_PERSONAL_OPEN=false
ALLOW_INSECURE_HTTP=false
MAX_MCP_SESSIONS=32
MAX_CONCURRENT_REQUESTS=16
MAX_REQUESTS_PER_SESSION=4
MCP_SESSION_IDLE_SECONDS=1800
MAX_REQUEST_BODY_BYTES=1572864
MAX_CONCURRENT_LOGINS=16
GRACEFUL_SHUTDOWN_SECONDS=30
METRICS_ENABLED=true
# Optional outbound proxy and private CA. Never disable TLS verification.
YUQUE_HTTPS_PROXY=
YUQUE_CA_FILE=

# Optional SMS login via the DrissionPage captcha sidecar. Disabled by default;
# enabling it requires a real Chrome/Chromium plus Python with DrissionPage.
# The captcha connects directly by default; set YUQUE_HTTPS_PROXY above only if
# risk control rejects it (the service then suggests switching the egress proxy).
SMS_CAPTCHA_ENABLED=false
CAPTCHA_PYTHON_PATH=python3
CAPTCHA_SOLVE_PATH=./captcha/solve.py
CAPTCHA_BROWSER_PATH=/usr/bin/chromium
# Only for root/NoNewPrivs containers that cannot build a Chromium sandbox. Risky.
# CAPTCHA_NO_SANDBOX=true
